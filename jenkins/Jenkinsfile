pipeline {
    agent any

    environment {
        EC2_USER = credentials('ec2-user')
        EC2_HOST = credentials('ec2-host')
        APP_DIR = 'todo-devops-lab'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate') {
            steps {
                sh '''
                  test -f backend/Dockerfile
                  test -f frontend/Dockerfile
                  test -f deploy/deploy.sh
                  test -f backend/db/init.sql
                  test -f backend/db/migrate-email.sql
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh 'docker build -t todo-backend:${BUILD_NUMBER} ./backend'
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh 'docker build -t todo-frontend:${BUILD_NUMBER} ./frontend'
            }
        }

        stage('Deploy Source to EC2') {
            steps {
                sshagent(credentials: ['ec2-ssh-key']) {
                    sh '''
                      ssh -o StrictHostKeyChecking=no "$EC2_USER@$EC2_HOST" "mkdir -p ~/$APP_DIR"
                      scp -o StrictHostKeyChecking=no -r backend frontend deploy "$EC2_USER@$EC2_HOST:~/$APP_DIR/"
                    '''
                }
            }
        }

        stage('Deploy on EC2') {
            steps {
                sshagent(credentials: ['ec2-ssh-key']) {
                    sh '''
                      ssh -o StrictHostKeyChecking=no "$EC2_USER@$EC2_HOST" \
                        "cd ~/$APP_DIR && chmod +x deploy/deploy.sh && ./deploy/deploy.sh"
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                sshagent(credentials: ['ec2-ssh-key']) {
                    sh '''
                      ssh -o StrictHostKeyChecking=no "$EC2_USER@$EC2_HOST" \
                        "curl -fsS http://localhost/api/health"
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker image rm todo-backend:${BUILD_NUMBER} todo-frontend:${BUILD_NUMBER} 2>/dev/null || true'
        }
    }
}
