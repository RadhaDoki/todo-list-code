pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        AWS_REGION = 'ap-south-2'
        AWS_ACCOUNT_ID = credentials('aws-account-id')

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_BACKEND = "${ECR_REGISTRY}/todo-backend"
        ECR_FRONTEND = "${ECR_REGISTRY}/todo-frontend"

        ECS_CLUSTER = 'todo-ecs-cluster'
        BACKEND_SERVICE = 'todo-backend'
        FRONTEND_SERVICE = 'todo-frontend'
        ECR_IMAGE_TAG = 'latest'

        // Configure these in Jenkins or replace with environment-specific values.
        ECS_EXECUTION_ROLE_ARN = credentials('ecs-execution-role-arn')
        SECRET_ARN = credentials('todo-app-secret-arn')
        DB_HOST = credentials('todo-db-host')
        BACKEND_URL = credentials('todo-backend-url')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate') {
            steps {
                sh '''
                    set -e
                    test -f backend/Dockerfile
                    test -f frontend/Dockerfile
                    test -f backend/db/init.sql
                    test -f backend/db/migrate-email.sql
                    echo "Validation successful"
                '''
            }
        }

        stage('Verify Existing ECR Images') {
            steps {
                sh '''
                    set -e
                    aws ecr describe-images \
                        --repository-name todo-backend \
                        --image-ids imageTag="$ECR_IMAGE_TAG" \
                        --region "$AWS_REGION" >/dev/null
                    aws ecr describe-images \
                        --repository-name todo-frontend \
                        --image-ids imageTag="$ECR_IMAGE_TAG" \
                        --region "$AWS_REGION" >/dev/null
                '''
            }
        }

        stage('Render Task Definitions') {
            steps {
                sh '''
                    set -e
                    rm -rf rendered
                    mkdir -p rendered

                    python3 - <<'PY'
import os
from pathlib import Path

backend_replacements = {
    "ECS_EXECUTION_ROLE_ARN": os.environ["ECS_EXECUTION_ROLE_ARN"],
    "BACKEND_IMAGE": f"{os.environ['ECR_BACKEND']}:{os.environ['ECR_IMAGE_TAG']}",
    "AWS_REGION": os.environ["AWS_REGION"],
    "DB_HOST": os.environ["DB_HOST"],
    "SECRET_ARN": os.environ["SECRET_ARN"],
}

frontend_replacements = {
    "ECS_EXECUTION_ROLE_ARN": os.environ["ECS_EXECUTION_ROLE_ARN"],
    "FRONTEND_IMAGE": f"{os.environ['ECR_FRONTEND']}:{os.environ['ECR_IMAGE_TAG']}",
    "BACKEND_URL": os.environ["BACKEND_URL"].rstrip("/"),
    "AWS_REGION": os.environ["AWS_REGION"],
}

backend = Path("task-definitions/backend.json").read_text()
for key, value in backend_replacements.items():
    backend = backend.replace(f"${{{key}}}", value)
Path("rendered/backend.json").write_text(backend)

frontend = Path("task-definitions/frontend.json").read_text()
for key, value in frontend_replacements.items():
    frontend = frontend.replace(f"${{{key}}}", value)
Path("rendered/frontend.json").write_text(frontend)
PY

                    test -n "$BACKEND_URL"
                    python3 - <<'PY'
import json
from pathlib import Path

for path in (Path("rendered/backend.json"), Path("rendered/frontend.json")):
    document = path.read_text()
    if "${" in document:
        raise SystemExit(f"Unresolved placeholder in {path}")
    json.loads(document)
PY
                    grep -nE 'ECS_EXECUTION_ROLE_ARN|BACKEND_IMAGE|FRONTEND_IMAGE|BACKEND_URL|DB_HOST|SECRET_ARN|AWS_REGION' rendered/*.json || true
                '''
            }
        }

        stage('Register Task Definitions') {
            steps {
                sh '''
                    set -e

                    aws ecs register-task-definition                       --cli-input-json file://rendered/backend.json                       --region "$AWS_REGION"

                    aws ecs register-task-definition                       --cli-input-json file://rendered/frontend.json                       --region "$AWS_REGION"
                '''
            }
        }

        stage('Ensure CloudWatch Log Groups') {
            steps {
                sh '''
                    set -e

                    for LOG_GROUP in /ecs/todo-backend /ecs/todo-frontend; do
                        if ! aws logs describe-log-groups \
                            --log-group-name-prefix "$LOG_GROUP" \
                            --region "$AWS_REGION" \
                            --query "logGroups[?logGroupName=='$LOG_GROUP'] | length(@)" \
                            --output text | grep -q '^1$'; then
                            aws logs create-log-group \
                                --log-group-name "$LOG_GROUP" \
                                --region "$AWS_REGION"
                        fi
                    done
                '''
            }
        }

        stage('Deploy ECS Services') {
            steps {
                sh '''
                    set -e

                    BACKEND_TASK_DEF=$(aws ecs describe-task-definition                       --task-definition todo-backend                       --region "$AWS_REGION"                       --query 'taskDefinition.taskDefinitionArn'                       --output text)

                    FRONTEND_TASK_DEF=$(aws ecs describe-task-definition                       --task-definition todo-frontend                       --region "$AWS_REGION"                       --query 'taskDefinition.taskDefinitionArn'                       --output text)

                    aws ecs update-service                       --cluster "$ECS_CLUSTER"                       --service "$BACKEND_SERVICE"                       --task-definition "$BACKEND_TASK_DEF"                       --region "$AWS_REGION"

                    aws ecs update-service                       --cluster "$ECS_CLUSTER"                       --service "$FRONTEND_SERVICE"                       --task-definition "$FRONTEND_TASK_DEF"                       --region "$AWS_REGION"
                '''
            }
        }

        stage('Wait for Stable') {
            steps {
                sh '''
                    aws ecs wait services-stable                       --cluster "$ECS_CLUSTER"                       --services "$BACKEND_SERVICE" "$FRONTEND_SERVICE"                       --region "$AWS_REGION"
                '''
            }
        }

    }
}

